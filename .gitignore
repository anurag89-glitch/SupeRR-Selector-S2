# ---------------------------------------------------------------------------
# SupeRR Selector — files excluded from version control
#
# The Streamlit dashboard needs only:
#   dashboard/, outputs/stage5/, outputs/stage6/, requirements.txt,
#   .streamlit/config.toml
# ---------------------------------------------------------------------------

# Virtual environments
venv/
.venv/
env/
ENV/
virtualenv/

# Python bytecode, test caches and build artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Secrets and credentials — never commit these
.env
.env.*
!.env.example
.streamlit/secrets.toml
secrets.toml
*.pem
*.key
credentials*.json
service-account*.json

# Original raw competition datasets (large; not redistributed)
data/raw/

# Large derived intermediates. The dashboard reads only the approved
# outputs/stage5 and outputs/stage6 files, so these are kept local.
data/processed/

# Temporary files, logs and caches
*.log
logs/
tmp/
temp/
*.tmp
*.bak
.cache/
scratch_*.py

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
